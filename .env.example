# StarPost Manager Configuration

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/starpost?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/starpost
DB_NAME=starpost

# Application Secret Key (Used for session cookies)
SECRET_KEY=change-this-to-a-very-secure-random-secret-key-in-production

# Admin Credentials
ADMIN_USERNAME=admin
# Generate hash with: python scripts/make_password_hash.py
# Default below is for password: "admin"
ADMIN_PASSWORD_HASH=$2b$12$e80yq7K7mO4k/hY6q0F2/u6WzWv1Uf5cW7e9.G/O7jI9r5Bq.U5re

# Telegram Bot Configuration
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Channel ID or username (e.g., -1001234567890 or @mychannel)
TELEGRAM_CHANNEL_ID=

# Server Settings
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=False

# Default Preferences
DEFAULT_TIMEZONE=UTC
DEFAULT_THEME=midnight
DEFAULT_STAR_PRICE=50
DEFAULT_CAPTION_FOOTER=
STAR_SYNC_INTERVAL_MINUTES=15
